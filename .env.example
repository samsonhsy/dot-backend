# Copy this file to .env and fill in the actual values before running the stack.

# Database Configuration (local PostgreSQL container)
POSTGRES_DB=punkt_db
POSTGRES_USER=punkt_user
POSTGRES_PASSWORD=punkt_password

# The application consumes DATABASE_URL directly. Keep it in sync with the
# values above or override it entirely if you use Supabase or another host.
DATABASE_URL=postgresql+asyncpg://punkt_user:punkt_password@db:5432/punkt_db

# Object Storage Configuration (local MinIO container)
# These credentials are reused as the MinIO root user credentials.
S3_ACCESS_KEY=dotminio
S3_SECRET_KEY=dotminiosecret

FILE_STORAGE_ACCESS_KEY_ID=dotminio
FILE_STORAGE_SECRET_ACCESS_KEY=dotminiosecret
FILE_STORAGE_URL=http://minio:9000
FILE_STORAGE_REGION=us-east-1

############################################################
# JWT Configuration
############################################################
ACCESS_TOKEN_EXPIRE_HOURS=24
SECRET_KEY=your-secret-key
ALGORITHM=HS256

############################################################
# Free Tier Retrieval Configuration
############################################################
FREE_TIER_RETRIEVAL_LIMIT=10
RETRIEVAL_PERIOD_DAYS=30

############################################################
# Optional overrides
############################################################
# UVICORN_WORKERS=4
# When deploying against Supabase/S3, override DATABASE_URL and FILE_STORAGE_*.